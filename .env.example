# Salin file ini menjadi .env.local lalu isi dari
# Supabase Dashboard → Project Settings → API (atau tombol "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key Supabase (Project Settings -> API Keys). Bypass RLS; HANYA dipakai di
# server (route API admin & upload). Jangan beri prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Password untuk login panel /admin
ADMIN_PASSWORD=
# String acak panjang untuk menandatangani cookie sesi admin (JWT). Wajib di production,
# mis. hasil: openssl rand -base64 32
SESSION_SECRET=
